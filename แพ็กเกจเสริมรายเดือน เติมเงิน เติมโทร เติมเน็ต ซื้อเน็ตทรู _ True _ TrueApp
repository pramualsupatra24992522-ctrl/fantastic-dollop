@charset "utf-8";

.smartbanner { position: fixed; top: 53px; left: 0px; overflow-x: hidden; width: 100%; height: 84px; background: rgb(243, 243, 243); z-index: 500; }

.smartbanner__exit { position: absolute; top: calc(50% - 6px); left: 9px; display: block; margin: 0px; width: 12px; height: 12px; border: 0px; text-align: center; }

.smartbanner__exit::before, .smartbanner__exit::after { position: absolute; width: 1px; height: 12px; background: rgb(113, 111, 111); content: " "; }

.smartbanner__exit::before { transform: rotate(45deg); }

.smartbanner__exit::after { transform: rotate(-45deg); }

.smartbanner__icon { position: absolute; top: 20px; left: 30px; width: 48px; height: 48px; border-radius: 15px; background-size: 48px 48px; }

.smartbanner__info { position: absolute; top: 13px; left: 86px; right: 66px; display: flex; overflow-y: hidden; width: auto; height: 64px; align-items: center; color: rgb(0, 0, 0); }

.smartbanner__info__title { font-size: 14px; }

.smartbanner__info__author, .smartbanner__info__price { font-size: 12px; }

.smartbanner__button { position: absolute; top: 32px; right: 10px; z-index: 1; display: block; padding: 0px 10px; min-width: 10%; border-radius: 5px; background: rgb(224, 0, 0); color: rgb(255, 255, 255); font-size: 18px; text-align: center; text-decoration: none; }

.smartbanner__button__label { text-align: center; }

.smartbanner { background: url("data:image/gif;base64,R0lGODlhCAAIAIABAFVVVf///yH5BAEHAAEALAAAAAAIAAgAAAINRG4XudroGJBRsYcxKAA7") rgb(61, 61, 61); box-shadow: rgb(224, 0, 0) 0px 4px 0px inset; }

.smartbanner .smartbanner__exit { left: 6px; margin-right: 7px; width: 17px; height: 17px; border-radius: 14px; background: rgb(28, 30, 33); box-shadow: rgba(0, 0, 0, 0.8) 0px 1px 2px inset, rgba(255, 255, 255, 0.3) 0px 1px 1px; color: rgb(177, 177, 179); font-family: ArialRoundedMTBold, Arial; font-size: 20px; line-height: 17px; text-shadow: rgb(0, 0, 0) 0px 1px 1px; }

.smartbanner .smartbanner__exit::before, .smartbanner .smartbanner__exit::after { top: 3px; left: 8px; width: 2px; height: 11px; background: rgb(177, 177, 179); }

.smartbanner .smartbanner__exit:active, .smartbanner .smartbanner__exit:hover { color: rgb(238, 238, 238); }

.smartbanner .smartbanner__icon { background-color: transparent; box-shadow: none; }

.smartbanner .smartbanner__info { color: rgb(204, 204, 204); text-shadow: rgb(0, 0, 0) 0px 1px 2px; }

.smartbanner .smartbanner__info__title { color: rgb(255, 255, 255); font-weight: bold; }

.smartbanner .smartbanner__button { top: 30px; right: 12px; padding: 0px; min-width: auto; border-radius: 0px; background: none; color: rgb(255, 255, 255); font-size: 14px; font-weight: bold; }

.smartbanner .smartbanner__button:active, .smartbanner .smartbanner__button:hover { background: none; }

.smartbanner .smartbanner__button__label { display: block; padding: 0px 10px; background: rgb(224, 0, 0); color: rgb(255, 255, 255); border-radius: 12px; box-shadow: none; line-height: 24px; text-align: center; text-shadow: none; text-transform: none; }

@media (min-width: 992px) {
  .smartbanner { top: 122px; }
}
